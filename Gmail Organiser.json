      "parameters": {
        "jsCode": "return $items(\"Get most recent read inbox email\").map(item => {\n  const sender = item.json.From ? item.json.From.split(\" <\")[0].toLowerCase() : null;\n  const labels = $items(\"Fetch all Gmail labels\").map(l => l.json.name.toLowerCase());\n  const labelExists = sender ? labels.includes(sender) : false;\n\n  return {\n    json: { senderName: sender, labelExists },\n    pairedItem: item\n  };\n});"
      },
